{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "cyber.html", "use": "@vercel/static" },
    { "src": "cyber.css", "use": "@vercel/static" },
    { "src": "cyber.js", "use": "@vercel/static" },
    { "src": "Nexus.png", "use": "@vercel/static" },
    { "src": "whale_shark.png", "use": "@vercel/static" },
    { "src": "login.html", "use": "@vercel/static" },
    { "src": "login.css", "use": "@vercel/static" },
    { "src": "login.js", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/", "destination": "cyber.html" },
    { "source": "/(.*)", "destination": "server.js" }
  ]
}